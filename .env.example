# Contact form email delivery (optional — the form falls back to WhatsApp if unset).
# Copy to .env.local for local dev, and set the same vars in Vercel → Settings →
# Environment Variables for production.

# 1) Create a free key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 2) Where enquiries are delivered.
#    On Resend's FREE tier (no verified domain) this MUST be the email you
#    signed up to Resend with — that's the only address it will deliver to.
CONTACT_TO_EMAIL=you@example.com

# 3) The "from" address (optional). Leave unset to use Resend's shared sender.
#    To use your own (e.g. hello@testi-tech.com) you must verify that domain
#    in Resend first (add the DNS records it gives you).
# CONTACT_FROM_EMAIL=Testi-Tech <onboarding@resend.dev>
